# Copy to config/deploy/.env; replace every CHANGE_ME before starting.
TZ=Asia/Shanghai
DATA_ROOT=/data/mediaforge
APP_IMAGE=mediaforge:release-001
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-bookworm
MINIO_IMAGE=mediaforge-minio:2025-10-15
MINIO_SOURCE_REF=RELEASE.2025-10-15T17-29-55Z
POSTGRES_USER=mediaforge
POSTGRES_DB=mediaforge
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_HEX
REDIS_PASSWORD=CHANGE_ME_REDIS_HEX
MINIO_ROOT_USER=mediaforge-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_HEX
APP_SECRET_KEY=CHANGE_ME_KEEP_EXISTING_SECRET_ON_MIGRATION
PUBLIC_BASE_URL=https://media.example.com
PUBLIC_MEDIA_BASE_URL=https://media.example.com
CANVAS_TASK_WORKER_CONCURRENCY=10
REDIS_MAX_CONNECTIONS=50
