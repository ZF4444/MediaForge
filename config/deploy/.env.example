# Copy to config/deploy/.env; replace every CHANGE_ME before starting.
# Production Docker deployment only; local development uses config/dev/.env.example.
TZ=Asia/Shanghai
DATA_ROOT=/data/mediaforge
APP_IMAGE=mediaforge:release-001
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-bookworm
MINIO_IMAGE=mediaforge-minio:2025-10-15
MINIO_SOURCE_REF=RELEASE.2025-10-15T17-29-55Z
POSTGRES_USER=mediaforge
POSTGRES_DB=mediaforge
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_HEX
REDIS_PASSWORD=CHANGE_ME_REDIS_HEX
MINIO_ROOT_USER=mediaforge-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_HEX
APP_SECRET_KEY=CHANGE_ME_KEEP_EXISTING_SECRET_ON_MIGRATION
PUBLIC_BASE_URL=https://media.example.com
PUBLIC_MEDIA_BASE_URL=https://media.example.com
CANVAS_TASK_WORKER_CONCURRENCY=100
REDIS_MAX_CONNECTIONS=200

# Video outward delivery: one config file, injected by service allowlists.
# The public-media Compose overlay is required; keep disabled until initialization.
MEDIA_GATEWAY_IMAGE=mediaforge-media-gateway:release-001
PUBLIC_VIDEO_ENABLED=false
PUBLIC_VIDEO_BASE_URL=https://download.example.com:18443
PUBLIC_VIDEO_WRITER_DSN=postgresql://media_writer:CHANGE_ME_WRITER_HEX@postgres:5432/media_auth
# Only gateway and one-off media-init receive the validator DSN.
PUBLIC_VIDEO_VALIDATOR_DSN=postgresql://media_validator:CHANGE_ME_VALIDATOR_HEX@postgres:5432/media_auth
# Admin DSN is synthesized from POSTGRES_* for media-init only; do not add it here.
PUBLIC_VIDEO_MINIO_ENDPOINT=minio:9000
PUBLIC_VIDEO_MINIO_ACCESS_KEY=media_gateway_reader
PUBLIC_VIDEO_MINIO_SECRET_KEY=CHANGE_ME_READ_ONLY_HEX
PUBLIC_VIDEO_MINIO_SECURE=false
PUBLIC_VIDEO_PREFIXES=mediaforge-private/users/,mediaforge-temp/users/
PUBLIC_VIDEO_IMMUTABLE_OBJECTS=false
PUBLIC_VIDEO_INTERNAL_ORIGINS=https://media.example.com
PUBLIC_VIDEO_DEFAULT_TTL_SECONDS=1800
PUBLIC_VIDEO_MAX_TTL_SECONDS=7200
PUBLIC_VIDEO_MAX_FILE_BYTES=524288000
PUBLIC_VIDEO_DOWNLOAD_CONCURRENCY=16
PUBLIC_VIDEO_STREAM_CHUNK_BYTES=262144
PUBLIC_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
PUBLIC_VIDEO_IO_TIMEOUT_SECONDS=15
PUBLIC_VIDEO_DATABASE_POOL_SIZE=4
