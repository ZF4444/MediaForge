# MediaForge local development configuration.
# Copy manually to config/.env and adjust for your existing local services.
# Do not commit config/.env: it contains infrastructure credentials and secrets.
# For production Docker deployment, use config/deploy/.env.example instead.

TZ=Asia/Shanghai

# Application connections to existing local infrastructure.
DATABASE_URL=postgresql://mediaforge:mediaforge_dev_password@127.0.0.1:5432/mediaforge

REDIS_URL=redis://127.0.0.1:6379/0

# Canvas Agent event outbox reconciliation. A stale tool-progress group is
# force-closed after the timeout; scanning runs at the configured interval.
AGENT_EVENT_TOOL_GROUP_TIMEOUT_SECONDS=300
AGENT_EVENT_TOOL_GROUP_SCAN_SECONDS=15

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=mediaforge_dev_password
MINIO_SECURE=false

# Generate once with openssl rand -hex 32 before saving AI connection keys.
# Keep this value fixed and backed up; changing it breaks existing encrypted keys.
# Provider connections/models are stored in PostgreSQL; API keys are encrypted
# in ai_connection_secrets. Configure them through the API settings page.
APP_SECRET_KEY=
