# Copy to config/dev/.env. Development only; do not use these passwords in production.
TZ=Asia/Shanghai
APP_IMAGE=mediaforge:dev
# Required when interpolating the shared production definition; dev uses named volumes.
DATA_ROOT=./unused-dev-data
POSTGRES_IMAGE=postgres:16-bookworm
REDIS_IMAGE=redis:7.4-bookworm
MINIO_IMAGE=mediaforge-minio:2025-10-15
MINIO_SOURCE_REF=RELEASE.2025-10-15T17-29-55Z
POSTGRES_USER=mediaforge
POSTGRES_DB=mediaforge
POSTGRES_PASSWORD=mediaforge_dev_password
REDIS_PASSWORD=mediaforge_dev_redis_password
MINIO_ROOT_USER=mediaforge-admin
MINIO_ROOT_PASSWORD=mediaforge_dev_minio_password
# Generate once with openssl rand -hex 32; preserve when migrating existing encrypted keys.
APP_SECRET_KEY=
CANVAS_TASK_WORKER_CONCURRENCY=100
REDIS_MAX_CONNECTIONS=200
AGENT_EVENT_TOOL_GROUP_TIMEOUT_SECONDS=300
AGENT_EVENT_TOOL_GROUP_SCAN_SECONDS=15

# Optional build mirrors for slow networks (defaults use official sources).
# DEBIAN_MIRROR=mirrors.ustc.edu.cn
# GOPROXY=https://goproxy.cn,direct

# Host HTTP port; change if an existing service or Windows portproxy occupies 3000.
DEV_HTTP_PORT=3000

# Optional locally imported Node image for offline migration.
# FRONTEND_IMAGE=mediaforge-node:22-dev

# Set to 0.0.0.0 when access through the Ubuntu network interface is required.
DEV_HTTP_BIND=127.0.0.1

# Optional public video delivery. Defaults remain off; see the public-media guide.
# Generate separate passwords (at least 24 characters); never use POSTGRES_PASSWORD.
PUBLIC_VIDEO_ENABLED=false
PUBLIC_VIDEO_BASE_URL=https://localhost:18443
PUBLIC_VIDEO_WRITER_DSN=postgresql://media_writer:REPLACE_WRITER_PASSWORD@postgres:5432/media_auth
# Injected only into gateway and one-off media initialization, not API/Worker.
PUBLIC_VIDEO_VALIDATOR_DSN=postgresql://media_validator:REPLACE_VALIDATOR_PASSWORD@postgres:5432/media_auth
PUBLIC_VIDEO_MINIO_ENDPOINT=minio:9000
PUBLIC_VIDEO_MINIO_ACCESS_KEY=media_gateway_reader
PUBLIC_VIDEO_MINIO_SECRET_KEY=REPLACE_READ_ONLY_SECRET
PUBLIC_VIDEO_MINIO_SECURE=false
PUBLIC_VIDEO_PREFIXES=mediaforge-private/users/,mediaforge-temp/users/
PUBLIC_VIDEO_IMMUTABLE_OBJECTS=false
PUBLIC_VIDEO_INTERNAL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional bounded media settings; unset values use the application defaults.
# PUBLIC_VIDEO_DEFAULT_TTL_SECONDS=1800
# PUBLIC_VIDEO_MAX_TTL_SECONDS=7200
# PUBLIC_VIDEO_MAX_FILE_BYTES=524288000
# PUBLIC_VIDEO_DOWNLOAD_CONCURRENCY=16
# PUBLIC_VIDEO_STREAM_CHUNK_BYTES=262144
# PUBLIC_VIDEO_DOWNLOAD_TIMEOUT_SECONDS=600
# PUBLIC_VIDEO_IO_TIMEOUT_SECONDS=15
# PUBLIC_VIDEO_DATABASE_POOL_SIZE=4
